{
  "name": "localcutvideo",
  "version": "0.12.0",
  "description": "Privacy-first video editor running 100% in the browser: auto-cut, Whisper subtitles, auto-framing, MP4 export.",
  "license": "MIT",
  "author": "Maxence Bonnici",
  "repository": {
    "type": "git",
    "url": "https://github.com/ImMaxence/LocalCutVideo.git"
  },
  "homepage": "https://localcutvideo.mbonnici.fr",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/service-worker": "^22.2.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@huggingface/transformers": "^4.3.2",
    "@jsverse/transloco": "^8.4.0",
    "@mediapipe/tasks-vision": "^1.2.0",
    "comlink": "^4.4.2",
    "dexie": "^4.4.7",
    "mediabunny": "^1.65.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "wavesurfer.js": "^8.0.4"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2"
  }
}
